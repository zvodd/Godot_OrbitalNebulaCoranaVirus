#!/usr/bin/env python
"""SCons build for the planet_core GDExtension.

Run from this directory:

    cd addons/planet_core && scons platform=linux target=template_debug -j4

The output is `bin/libplanet_core<platform>.<target>.<arch>.so`, which is what
`planet_core.gdextension` points at.

godot-cpp is a build dependency kept outside the game repo. It is looked for at
the path in $GODOT_CPP_PATH, then as a sibling of the game repo
(`../../../godot-cpp` from here), then vendored next to this file. Override with
`scons godot_cpp=/abs/path/to/godot-cpp`.
"""

import os

EnsureSConsVersion(4, 0)
EnsurePythonVersion(3, 8)

API_VERSION = "4.7"

# ---------------------------------------------------------------------------
# Locate godot-cpp. It is a build dependency kept outside the game repo.
# ---------------------------------------------------------------------------

here = os.path.abspath(Dir(".").srcnode().abspath)

candidates = []
explicit = ARGUMENTS.get("godot_cpp", os.environ.get("GODOT_CPP_PATH", ""))
if explicit:
    candidates.append(explicit)
candidates += [
    os.path.join(here, "..", "..", "..", "godot-cpp"),  # <projects>/godot-cpp
    os.path.join(here, "godot-cpp"),                    # vendored copy, if any
]

godot_cpp_path = None
for candidate in candidates:
    candidate = os.path.abspath(candidate)
    if os.path.isfile(os.path.join(candidate, "SConstruct")):
        godot_cpp_path = candidate
        break

if godot_cpp_path is None:
    print(
        "ERROR: godot-cpp not found.\n"
        "Build/link it first (see https://github.com/godotengine/godot-cpp), then either\n"
        "  * place it next to the game repo (a sibling of the repo root), or\n"
        "  * export GODOT_CPP_PATH=/path/to/godot-cpp, or\n"
        "  * pass  scons godot_cpp=/path/to/godot-cpp"
    )
    Exit(1)

print("planet_core: using godot-cpp at %s" % godot_cpp_path)

# godot-cpp's SConstruct is happy to rebuild its whole static library here (180-odd binding
# sources, several minutes) even when an up-to-date `bin/libgodot-cpp*.a` already exists. When it
# does exist, ask for link-only: godot-cpp still registers the .a as a link dependency, so the
# extension links against the prebuilt archive. Force a from-source rebuild with
# `scons build_godot_cpp=yes`. SConscript arguments are not propagated into godot-cpp's option
# parser, so `build_library` has to be set on the global ARGUMENTS instead.
prebuilt_dir = os.path.join(godot_cpp_path, "bin")
prebuilt_libs = [
    n for n in (os.listdir(prebuilt_dir) if os.path.isdir(prebuilt_dir) else [])
    if n.startswith("libgodot-cpp") and n.endswith(".a")
]
if prebuilt_libs and ARGUMENTS.get("build_godot_cpp", "no") not in ["yes", "true", "1"]:
    print("planet_core: reusing prebuilt godot-cpp (%s); build_godot_cpp=yes to rebuild it" % prebuilt_libs[0])
    ARGUMENTS["build_library"] = "no"

env = SConscript(os.path.join(godot_cpp_path, "SConstruct"), {"api_version": API_VERSION})


# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

if env["target"] in ["editor", "template_debug"]:
    doc_data = env.GodotCPPDocData("src/gen/doc_data.gen.cpp", source=Glob("doc_classes/*.xml"))
    sources.append(doc_data)

library = env.SharedLibrary(
    target="bin/libplanet_core{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
